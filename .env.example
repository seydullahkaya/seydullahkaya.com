# Bu dosyayı .env.local olarak kopyalayıp gerçek değerleri gir. .env.local repoya eklenmez.
# Vercel'de aynı değişkenleri Project Settings → Environment Variables altına ekle.

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# İsteğe bağlı: varsayılan gönderici "Seydullah Kaya <iletisim@seydullahkaya.com>"
# (alan adı Resend'de doğrulanmış olmalı).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=seydullahkaya@gmail.com

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Site anahtarı kodda (components/contact/contact-form.tsx); sadece farklı bir widget için gerekir.
# Geliştirmede gizli anahtar boşsa Cloudflare'in test anahtarı kullanılır.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
