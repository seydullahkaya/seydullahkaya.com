# Bu dosyayı .env.local olarak kopyalayıp gerçek değerleri gir. .env.local repoya eklenmez.
# Vercel'de aynı değişkenleri Project Settings → Environment Variables altına ekle.

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Alan adı Resend'de doğrulanana kadar onboarding@resend.dev kullanılır
# (bu adres sadece Resend hesabının e-postasına gönderebilir).
CONTACT_FROM_EMAIL="seydullahkaya.com <iletisim@seydullahkaya.com>"
CONTACT_TO_EMAIL=seydullahkaya@gmail.com

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Boş bırakılırsa geliştirmede Cloudflare'in test anahtarları kullanılır.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
